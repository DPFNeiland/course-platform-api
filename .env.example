# Desenvolvimento local: quando API_BASE_URL estiver vazia, o frontend usa frontend/config.js.
APP_ENV=development
API_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Homologacao:
# APP_ENV=staging
# API_BASE_URL=https://api-hml.exemplo.com
# CORS_ALLOWED_ORIGINS=https://app-hml.exemplo.com

# Producao:
# APP_ENV=production
# API_BASE_URL=https://api.exemplo.com
# CORS_ALLOWED_ORIGINS=https://app.exemplo.com

# API_BASE_URL deve ser uma URL publica, acessivel pelo navegador.
# Em staging e production ela e obrigatoria e deve utilizar HTTPS.
# CORS_ALLOWED_ORIGINS deve conter a origem publica do frontend.
